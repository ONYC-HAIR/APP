# Profile Scraper Configuration
# Copy this file to .env and modify the values as needed

# Rate limiting (seconds between requests)
SCRAPER_REQUEST_DELAY=2.0

# Maximum results per search
SCRAPER_MAX_RESULTS=50

# Browser settings
SCRAPER_HEADLESS=true

# Database path
SCRAPER_DB_PATH=scraper_results.db

# Logging level (DEBUG, INFO, WARNING, ERROR)
SCRAPER_LOG_LEVEL=INFO

# Search engines to use (comma-separated: google,bing,duckduckgo)
SCRAPER_SEARCH_ENGINES=google,bing,duckduckgo

# Output directory for exported files
SCRAPER_OUTPUT_DIR=scraped_data

# Maximum concurrent requests
SCRAPER_MAX_CONCURRENT=3

# Request timeout (seconds)
SCRAPER_TIMEOUT=30